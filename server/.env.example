# Copy to server/.env (local) or to the env file used by `docker run --env-file` (server).
# Never commit real values.

PORT=8080
NODE_ENV=production

# Frontend origin allowed by CORS and socket.io
CORS_ORIGIN=https://bestartgallery.pp.ua

# Session cookie signing secret: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
# Set to false only for local HTTP development
COOKIE_SECURE=true

# MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=PaintingsDB

# Public URLs. API_URL must include the /api prefix: payment callbacks go to ${API_URL}/payments/...
APP_URL=https://bestartgallery.pp.ua
API_URL=https://bestartgallery.pp.ua/api

# Payments: wayforpay (default) or fondy
PAYMENT_PROVIDER=wayforpay

# WayForPay (merchant portal → store settings). Public test merchant from the WayForPay docs:
# account test_merch_n1, secret flk3409refn54t54t*FNJRET (test payments only).
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
# Domain registered for the store in WayForPay; defaults to the APP_URL host
WAYFORPAY_DOMAIN=bestartgallery.pp.ua

# Fondy (optional fallback, only if PAYMENT_PROVIDER=fondy or old Fondy orders are still pending)
FONDY_MERCHANT_ID=
FONDY_SECRET=
FONDY_API_URL=https://api.fondy.eu
